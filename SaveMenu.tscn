[gd_scene load_steps=2 format=3 uid="uid://cfecs5jvwrwcq"]

[sub_resource type="GDScript" id="GDScript_bvjo0"]
script/source = "extends Control

@onready var file_name_input = $MenuContainer/FileNameInput
@onready var save_list_container = $MenuContainer/SaveList/SaveListContainer
@onready var main_node = get_tree().get_root().get_node(\"Main\")  # Referencia al nodo Main

var save_path = \"user://saves/\"  # Carpeta donde se guardarán los archivos
var selected_save: String = \"\"  # Nombre del archivo seleccionado para cargar

func _ready():
	# Conectar señales de los botones
	$MenuContainer/ButtonContainer/SaveButton.pressed.connect(_on_save_button_pressed)
	$MenuContainer/ButtonContainer/LoadButton.pressed.connect(_on_load_button_pressed)
	$MenuContainer/CloseButton.pressed.connect(_on_close_button_pressed)
	
	# Crear la carpeta de guardado si no existe
	DirAccess.make_dir_absolute(save_path)
	
	# Listar partidas guardadas al abrir el menú
	update_save_list()

func _on_save_button_pressed():
	var file_name = file_name_input.text.strip_edges()
	if file_name == \"\":
		print(\"Please enter a save name!\")
		return
	
	# Guardar el estado del juego
	var game_state = main_node.save_game_state()
	var save_file_path = save_path + file_name + \".tres\"
	var error = ResourceSaver.save(game_state, save_file_path)
	if error == OK:
		print(\"Game saved successfully to: \", save_file_path)
	else:
		print(\"Error saving game: \", error)
	
	# Actualizar la lista de partidas guardadas
	update_save_list()

func _on_load_button_pressed():
	if selected_save == \"\":
		print(\"Please select a save to load!\")
		return
	
	# Cargar el estado del juego
	var save_file_path = save_path + selected_save
	if ResourceLoader.exists(save_file_path):
		var game_state = ResourceLoader.load(save_file_path) as GameState
		if game_state:
			main_node.load_game_state(game_state)
			print(\"Game loaded successfully from: \", save_file_path)
			# Cerrar el menú después de cargar
			queue_free()
		else:
			print(\"Error: Loaded resource is not a GameState!\")
	else:
		print(\"Save file does not exist: \", save_file_path)

func _on_close_button_pressed():
	queue_free()

func update_save_list():
	# Limpiar la lista actual
	for child in save_list_container.get_children():
		child.queue_free()
	
	# Listar archivos en la carpeta de guardado
	var dir = DirAccess.open(save_path)
	if dir:
		dir.list_dir_begin()
		var file_name = dir.get_next()
		while file_name != \"\":
			if !dir.current_is_dir() and file_name.ends_with(\".tres\"):
				var save_name = file_name.replace(\".tres\", \"\")
				var button = Button.new()
				button.text = save_name
				button.pressed.connect(_on_save_selected.bind(save_name))
				save_list_container.add_child(button)
			file_name = dir.get_next()
		dir.list_dir_end()
	else:
		print(\"Error accessing save directory: \", save_path)

func _on_save_selected(save_name: String):
	selected_save = save_name
	print(\"Selected save: \", save_name)
"

